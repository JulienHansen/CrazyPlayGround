{
  "version": 1,
  "wandb": { "project": "hovering" },
  "defaults": {
    "trainer": "skrl",
    "env_name": "Vel-Hovering",
    "algo": "PPO",
    "num_envs": 4096,
    "total_timesteps": 78643200,
    "rollout_length": 32,
    "lr": 5e-4,
    "lambda_coef": 0.95,
    "entropy_coef": 0.0,
    "env_kwargs": { "add_noise": true, "noise_std": 0.01 },
    "seed": [42, 123, 7]
  },
  "experiments": [
    { "name": "noise-off", "env_kwargs": { "add_noise": false } },
    { "name": "lr-scan", "sweep": { "lr": [2.5e-4, 5e-4, 1e-3] } }
  ]
}
