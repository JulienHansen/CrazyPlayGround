{
  "version": 1,
  "wandb": { "project": "hovering-mixer" },
  "defaults": {
    "trainer": "skrl",
    "env_name": "Vel-Hovering",
    "algo": "PPO",
    "num_envs": 8192,
    "total_timesteps": 200e6,
    "rollout_length": 64,
    "lr": 2.5e-4,
    "lambda_coef": 0.99,
    "entropy_coef": 0.0,
    "env_kwargs": {
      "obs_input_hist": 4,
      "action_input_hist": 0,
      "add_noise": true,
      "noise_std": 0.03,
      "noise_corr": 0.9,
      "noise_bias_std": 0.015,
      "wind_force_range": [0.0, 0.05],
      "thrust_scale_range": [1.0, 1.0],
      "torque_scale_range": [1.0, 1.0],
      "motor_tau_range": [0.055, 0.090],
      "action_latency_steps": 2,
      "action_latency_max_steps": 6,
      "distance_reward_shape": "multiexp",
      "distance_reward_scales": [1.0, 0.5, 0.1, 0.05, 0.01],
      "distance_reward_length": 0.8,
      "distance_reward_length_min": 0.1,
      "distance_reward_curriculum_ratio": 1.0
    },
    "seed": [42, 123, 7, 29, 11]
  },
  "experiments": [
    {
      "name": "hist-1",
      "env_kwargs": { "obs_input_hist": 1, "action_input_hist": 1 },
      "sweep": {
        "lr": [1.0e-4, 2.5e-4, 5.0e-4],
        "lambda_coef": [0.9, 0.95, 0.99]
      }
    },
    {
      "name": "hist-4",
      "env_kwargs": { "obs_input_hist": 4, "action_input_hist": 4 },
      "sweep": {
        "lr": [1.0e-4, 2.5e-4, 5.0e-4],
        "lambda_coef": [0.9, 0.95, 0.99]
      }
    },
    {
      "name": "hist-8",
      "env_kwargs": { "obs_input_hist": 8, "action_input_hist": 8 },
      "sweep": {
        "lr": [1.0e-4, 2.5e-4, 5.0e-4],
        "lambda_coef": [0.9, 0.95, 0.99]
      }
    }
  ]
}
